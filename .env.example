# ❗This file is an example of all required Environment Variables to run this project
# ❗Make sure you create a new .env file with the following variables and assign their corresponding values

PORT=              # PORT to use locally. For example: 5005

# CORS 
ORIGIN=            # URL of Client for CORS. For example: "http://localhost:5173"
CORS_ORIGINS=      # Comma-separated list of allowed origins for CORS. For example: "http://localhost:5173,http://example.com"

MONGODB_URI=       # Location of MongoDB Database. For example: "mongodb://127.0.0.1:27017/my-database"
TOKEN_SECRET=      # Secret key for signing tokens. For example: "my-super-secret"
CLOUDINARY_NAME=   # Cloudinary cloud name
CLOUDINARY_KEY=    # Cloudinary API key
CLOUDINARY_SECRET= # Cloudinary API secret